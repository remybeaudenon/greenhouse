    {
        "id": "05c142028349c498",
        "type": "function",
        "z": "445503803795d0d6",
        "name": "[mcu_state] Updater",
        "func": "let mcu_state = global.get(\"mcu_state\");\n\nif (!mcu_state) {\n    let model = global.get(\"DATA-MODEL\");\n    mcu_state = model ? JSON.parse(model) : {};\n}\nif (msg.topic === \"INIT\") \n{\n    if (Array.isArray(msg.payload) && msg.payload.length === 1) {\n        global.set(\"mcu_state\", msg.payload[0]);\n        msg.payload = msg.payload[0];\n        node.status({ fill: \"green\", shape: \"dot\", text: `INIT data-model.`});\n        \n        return [msg, null];\n    }\n}\nelse if (msg.topic === \"UPDATE\"  ||  msg.topic === \"nodered/mcu/state\" ||\n         msg.topic === \"nodered/mcu/cmd\"  ) {\n\n    //let update = (typeof msg.payload === \"object\") ? msg.payload : {};\n    let update =  msg.payload ;\n    let merged = Object.assign({}, mcu_state, update);\n    delete merged.time;\n    global.set(\"mcu_state\", merged);\n    msg.payload = merged;\n    node.status({ fill: \"green\", shape: \"dot\", text: `UPDATE data-model.`});\n    return [msg, msg];\n}\n\nreturn [null, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 120,
