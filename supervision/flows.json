    {
        "id": "5f78fed6c51835a0",
        "type": "function",
        "z": "445503803795d0d6",
        "name": "[mcu_cmd]  element/value -> { [element] : value} ",
        "func": "//{\n//    \"element\": \"fan\",\n//    \"type\": \"boolean\",\n//    \"mode\": \"absolute\",\n//    \"value\": \"false\"\n//}\n\nif (!msg.payload || msg.payload.mode === undefined || \n    msg.payload.value === undefined || msg.payload.value === null ||\n    msg.payload.element === undefined ) \n    {\n    node.warm({ fill: \"yellow\", shape: \"dot\", text: `Invalid payload:  ${JSON.stringify(msg.payload)}  `});\n    return [null, null] ;\n}\n\nlet storageMsg = RED.util.cloneMessage(msg);\n\n// [mcu_cmd]  element/value -> { [element] : value} \n\nlet field = msg.payload.element;\nlet value ;\n\nswitch (msg.payload.type) {\n    case 'boolean':\n        value = String(msg.payload.value).toLowerCase() === \"true\";\n        break;\n    case 'integer':\n        value = parseInt(msg.payload.value, 10);\n        if (isNaN(value)) return null;\n        break;\n    default:\n        value = msg.payload.value;\n}\nmsg.payload = { [field]: value };\nnode.status({ fill: \"green\", shape: \"dot\", text: `Valid CMD payload:  ${JSON.stringify(msg.payload)}  `});\n\nreturn  [msg , storageMsg];\n\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 380,
