    {
        "id": "599e8260b8aa2c28",
        "type": "function",
        "z": "445503803795d0d6",
        "name": "Check  Data Model Validity",
        "func": "msg.topic =  \"nodered/mcu/cmd\" ; \nlet httpMsg = RED.util.cloneMessage(msg);\n\n// Vérifier que msg.payload existe\nif (!msg.payload || typeof msg.payload !== \"object\") {\n    node.warn(\"msg.payload manquant ou invalide\");\n    httpMsg.statusCode = 400 ;  // HTTP Session RC bad request  \n    httpMsg.payload = { \"status\": \"msg.payload manquant ou invalide\" } ; \n    return [httpMsg,null] ;\n}\n\n// Liste des champs obligatoires\nconst requiredFields = [\"element\", \"type\", \"mode\", \"value\"];\n\n// Vérifier que tous les champs sont présents\nfor (let field of requiredFields) {\n    if (!(field in msg.payload)) {\n        node.warn(`Champ manquant: ${field}`);\n        httpMsg.payload = { \"status\": \"Champ manquant: ${field}\" } ; \n        httpMsg.statusCode = 400 ; \n        return [httpMsg,null];\n    }\n}\n\n// Pour info, on peut log le payload\nnode.status({fill:\"green\", shape:\"dot\", text:`Valid payload: ${JSON.stringify(msg.payload) } `});\n\nhttpMsg.payload = { \"status\": \"Valid payload: ${msg.payload.element}  value: ${msg.payload.value}\" } ; \nhttpMsg.statusCode = 200 ;  // HTTP Session RC \nreturn [httpMsg,msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
